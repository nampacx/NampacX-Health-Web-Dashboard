# Copy to `.env.local` and fill in.

# OAuth 2.0 Client ID of type "Web application" from Google Cloud Console.
# Its "Authorized JavaScript origins" must include every origin you serve from:
#   http://localhost:5173     (dev — localhost is the only http origin Google accepts)
#   https://mikokono.de       (GitHub Pages; check Settings > Pages for your real origin,
#                              which is the account's custom domain when one is set)
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Base URL for the Google Health API. Defaults to https://health.googleapis.com/v4,
# which the browser can call directly — the API sends permissive CORS headers.
# Only set this if you want to route calls through your own proxy.
# VITE_HEALTH_API_BASE=https://health.googleapis.com/v4

# --- Withings (optional) ---
# Public by design, like the Google client ID above. Create it as a Withings
# "Public Health Data API" app — see api/README.md for the full setup.
VITE_WITHINGS_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of the Azure Function token broker (api/), no trailing slash.
# Local dev: http://localhost:7071/api (after `npm start` in api/).
VITE_WITHINGS_BROKER_URL=https://<your-function-app>.azurewebsites.net/api

# Overrides the computed redirect URI. Must match the Withings app
# registration byte-for-byte, trailing slash included. Leave unset to use
# the page's own origin + base path.
# VITE_WITHINGS_REDIRECT_URI=https://mikokono.de/Google-Health-Web-Dashboard/

# Set to "1" to append mode=demo to the authorize URL, so you can exercise the
# whole flow against Withings' demo account with no physical scale.
# VITE_WITHINGS_DEMO=1
