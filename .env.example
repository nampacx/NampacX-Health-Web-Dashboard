# Copy to `.env.local` and fill in.

# OAuth 2.0 Client ID of type "Web application" from Google Cloud Console.
# Its "Authorized JavaScript origins" must include http://localhost:5173
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Base URL for the Google Health API.
# Default "/health-api/v4" goes through the Vite dev proxy (see vite.config.ts),
# which avoids browser CORS restrictions. Point it at
# https://health.googleapis.com/v4 only if you host your own CORS-enabled proxy.
# VITE_HEALTH_API_BASE=/health-api/v4
