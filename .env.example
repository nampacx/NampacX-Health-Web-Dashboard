# Copy to `.env.local` and fill in.

# OAuth 2.0 Client ID of type "Web application" from Google Cloud Console.
# Its "Authorized JavaScript origins" must include every origin you serve from:
#   http://localhost:5173     (dev — localhost is the only http origin Google accepts)
#   https://mikokono.de       (GitHub Pages; check Settings > Pages for your real origin,
#                              which is the account's custom domain when one is set)
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Base URL for the Google Health API. Defaults to https://health.googleapis.com/v4,
# which the browser can call directly — the API sends permissive CORS headers.
# Only set this if you want to route calls through your own proxy.
# VITE_HEALTH_API_BASE=https://health.googleapis.com/v4
